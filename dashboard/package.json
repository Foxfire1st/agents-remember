{
  "name": "agents-remember-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "codegen": "panda codegen",
    "prepare": "panda codegen --silent",
    "build": "panda codegen && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "perf:cockpit": "vitest run src/panels/session-cockpit/SessionRail.test.tsx src/panels/session-cockpit/VirtualizedInspectorList.test.tsx && playwright test --config playwright.perf.config.ts"
  },
