    "@types/three": "^0.184.1",
    "@webtui/css": "0.1.9",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "cmdk": "1.1.1",
    "gsap": "^3.15.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-aria-components": "^1.18.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0",
    "tinykeys": "4.0.0",
