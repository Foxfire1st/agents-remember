{
  "agents": {
    "defaults": {
      "workspace": "<PATH/TO/YOUR/PROJECTS_FOLDER>/.openclaw/workspace"
    }
  },
  "mcp": {
    "servers": {
      "agents-remember": {
        "command": "uvx",
        "args": [
          "--refresh-package",
          "agents-remember-mcp",
          "agents-remember-mcp@latest",
          "--config",
          "<PATH/TO/YOUR/PROJECTS_FOLDER>/.openclaw/mcp/agents-remember-settings.json"
        ]
      }
    }
  }
}
