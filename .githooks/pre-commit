#!/usr/bin/env sh
# Fast pre-commit tier: check the STAGED content — the thing the commit will
# actually contain — with deterministic lint/type/generated-copy checks.
# Measured on a clean checkout: ~11.4 s cold and ~10.8 s warm (Pyrefly ~1.8 s
# full pass, down from ~198 s under Pyright; the concurrent dashboard rail runs
# in parallel; peak combined RSS ~1.09 GiB cold, ~0.95 GiB warm). Full quality
# and test operations are explicit developer-requested workflows, not automatic
# test runs.
#
# Every landing route of the product runs this hook on the tree it publishes
# (MIK-R152) and refuses the landing on a failure; nothing publishes past it.
# Bypass intentionally with `git commit --no-verify`, remembering that the flag
# turns off every check, not just the one that annoyed you — and that no
# product route uses it.

hook_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)" || exit 1
exec "$hook_dir/_gate.sh" fast
