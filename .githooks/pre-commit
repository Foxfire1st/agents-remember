#!/usr/bin/env sh
# Fast pre-commit tier: certify the STAGED content — the thing the commit will
# actually contain — with ruff, Pyright, and the generated-copy checks. Under
# half a minute on a warm checkout. Tests run only through lifecycle-owned Dagger.
#
# Bypass intentionally with `git commit --no-verify`, remembering that the flag
# turns off every check, not just the one that annoyed you.

hook_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)" || exit 1
exec "$hook_dir/_gate.sh" fast
