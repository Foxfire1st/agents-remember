#!/usr/bin/env sh
# Full pre-push tier: run the project-owned suite over the working tree and
# block the push on any finding (ruff, Pyright, the full pytest suite, and
# mandatory CRAP).
#
# Bypass intentionally with `git push --no-verify`.

hook_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)" || exit 1
exec "$hook_dir/_gate.sh" full
