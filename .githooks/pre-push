#!/usr/bin/env sh
# Pre-push quality gate: run the project-owned suite and block the push on any
# finding (ruff, Pyright, the full pytest suite, and mandatory CRAP).
# Bypass intentionally with `git push --no-verify`.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Prerequisite:           pip install -e "mcp[dev]"
#
# Works from any branch and any git worktree. When the current checkout has no
# local .venv (the common worktree case), fall back to the primary worktree's
# .venv so the dev tools are available without a per-worktree install. The
# wrapper puts the current checkout's source first on PYTHONPATH, so the gate
# always measures *this* checkout's code regardless of which python runs it.

root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1

# Primary worktree root = parent of the shared (common) git dir. For a linked
# worktree this resolves to the main clone; for the main clone it resolves to
# itself.
common_git="$(git rev-parse --git-common-dir 2>/dev/null)"
main_root=""
if [ -n "$common_git" ]; then
  main_root="$(CDPATH= cd -- "$common_git/.." 2>/dev/null && pwd)"
fi

if [ -x ".venv/bin/python" ]; then
  py=".venv/bin/python"
elif [ -n "$main_root" ] && [ -x "$main_root/.venv/bin/python" ]; then
  py="$main_root/.venv/bin/python"
else
  py="$(command -v python3 || command -v python)"
fi
if [ -z "$py" ]; then
  echo "[pre-push] no python found; install the dev env: pip install -e 'mcp[dev]'" >&2
  exit 1
fi

echo "[pre-push] checking generated skill copies..."
"$py" scripts/sync-skills.py --check || exit 1
echo "[pre-push] checking generated runtime asset copies..."
"$py" scripts/sync-runtime.py --check || exit 1
echo "[pre-push] checking shipped dashboard bundle..."
"$py" scripts/sync-dashboard.py --check || exit 1
echo "[pre-push] running quality wrapper (ruff + Pyright + pytest + CRAP, enforcing)..."
checkout_pythonpath="$root/mcp/src"
if [ -n "${PYTHONPATH:-}" ]; then
  checkout_pythonpath="$checkout_pythonpath:$PYTHONPATH"
fi
PYTHONPATH="$checkout_pythonpath" "$py" -m agents_remember.code_quality.check
