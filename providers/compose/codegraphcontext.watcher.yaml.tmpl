  @WATCHER_SERVICE@:
    image: @RUNNER_IMAGE@
    container_name: @WATCHER_CONTAINER_NAME@
    labels:
@SERVICE_LABELS@
    restart: unless-stopped
    # L12 memory cap (incident 2026-07-03): a cgc watch process grew to 2.16GiB over two
    # days of file churn and, beside several uncapped per-worktree stacks, drove the host
    # into swap exhaustion. Steady-state watchers sit at 20-100MiB, so 512m is generous
    # headroom AND the recycle threshold: growth past it OOM-restarts the watcher
    # (unless-stopped) with the graph data safe in falkordb.
    mem_limit: 512m
    depends_on:
      falkordb:
        condition: service_healthy
@WATCHER_USER_BLOCK@    working_dir: @WATCHER_WORKING_DIR@
    volumes:
      - @WATCHER_RUNTIME_VOLUME@
      - @WATCHER_REPO_VOLUME@
    environment:
@WATCHER_ENVIRONMENT@
    # The guard waits for a genuine PONG and clears empty/partial graph keys
    # before exec'ing cgc, so a daemon-restart race can never latch the watcher
    # into watch-only mode over a poisoned graph.
    entrypoint: ["python", "/usr/local/bin/cgc-watch-guard.py"]
    command: ["watch", @WATCHER_REPO_PATH@]
