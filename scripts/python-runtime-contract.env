# Canonical Agents Remember Python runtime contract.
#
# This file is intentionally POSIX-shell-readable so local bootstrap, Git hooks,
# GitHub workflows, and Dagger consume one version and provenance authority.
AR_PYTHON_VERSION=3.14.8
AR_PYTHON_MINOR=3.14
AR_PYTHON_REQUIRES='>=3.14,<3.15'
AR_PYTHON_SOURCE_URL=https://www.python.org/ftp/python/3.14.8/Python-3.14.8.tar.xz
AR_PYTHON_SOURCE_SHA256=c2215904f02b175596dc49351585104f4bc20341e1c47378b26a2c274360ce73
AR_PYTHON_BUILD_REPOSITORY=https://github.com/pyenv/pyenv.git
AR_PYTHON_BUILD_COMMIT=f9d17bfc06ccbda37edd84df99a4f50d8d7d2a4a
AR_UV_VERSION=0.12.6
AR_PYTHON_APT_BUILD_DEPS='build-essential ca-certificates curl git libbz2-dev libffi-dev liblzma-dev libncurses-dev libreadline-dev libsqlite3-dev libssl-dev libxml2-dev libxmlsec1-dev libzstd-dev tk-dev uuid-dev xz-utils zlib1g-dev'
