# Canonical Agents Remember Python runtime contract.
#
# This file is intentionally POSIX-shell-readable so local bootstrap, Git hooks,
# GitHub workflows, and Dagger consume one version and provenance authority.
AR_PYTHON_VERSION=3.13.15
AR_PYTHON_MINOR=3.13
AR_PYTHON_REQUIRES='>=3.13,<3.14'
AR_PYTHON_SOURCE_URL=https://www.python.org/ftp/python/3.13.15/Python-3.13.15.tar.xz
AR_PYTHON_SOURCE_SHA256=1e66a7945a48390ee4c2a4268a0e4185884059a13c4aab6d148aa208deea4a76
AR_PYTHON_BUILD_REPOSITORY=https://github.com/pyenv/pyenv.git
AR_PYTHON_BUILD_COMMIT=4733cca31b0f63eab95937f179584ba0d47d44d5
AR_UV_VERSION=0.12.6
AR_PYTHON_APT_BUILD_DEPS='build-essential ca-certificates curl git libbz2-dev libffi-dev liblzma-dev libncursesw5-dev libreadline-dev libsqlite3-dev libssl-dev libxml2-dev libxmlsec1-dev tk-dev uuid-dev xz-utils zlib1g-dev'
