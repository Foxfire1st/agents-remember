# Canonical Agents Remember Python runtime contract.
#
# This file is POSIX-shell-readable so local bootstrap, Git hooks,
# GitHub workflows, and Dagger select the same interpreter line.
AR_PYTHON_MINOR=3.14
AR_PYTHON_REQUIRES='>=3.14,<3.15'
# Hosts accept this uv minor line or newer. CI and Dagger install the newest patch in this line.
AR_UV_VERSION=0.13
