uv.lock
# The MCP runtime is an application as well as a published package. Its canonical
# development, Dagger, CI, and release environments all consume one frozen lock.
!mcp/uv.lock
mcp/tests/fixtures/sim-rich/
.dashboard-pastes/
/.deepsec/

# The built cockpit bundle is a generated artifact, produced by the release job
# (npm --prefix dashboard run build, then scripts/sync-dashboard.py) and shipped inside
# the wheel and sdist -- never committed. A 28 MB generated tree in version control is
# what made the pre-commit gate unpassable and trained the --no-verify habit.
/mcp/src/agents_remember/package_data/dashboard/
/mcp/src/agents_remember/package_data/dashboard.fingerprint

# `python -m build` in mcp/ (the release job's packaging step, and how anyone checks a
# wheel locally) drops these in-tree; an untracked build product must not dirty the gate.
/mcp/build/
/mcp/dist/

# Type-checker daemon and cache artifacts. `dmypy` writes a `.dmypy.json` holding a pid and
# a socket path next to whatever it was pointed at -- it landed in `mcp/src/` twice during
# this task's tooling evaluation. That matters more than it used to: closeout now stages the
# whole worktree before gating (so the gate can see created files), so anything untracked and
# unignored is staged and committed rather than merely ignored by ruff.
.dmypy.json
.mypy_cache/
