# Agents Remember shared-mode path configuration
#
# Normal first-run setup is repo-local and does not require AR_COORDINATION_ROOT.
# Use this file only when you explicitly want shared scaffolding for one or
# more repositories. Relative paths resolve from this .env file.
#
# The resolver does not read .env.example at runtime. Copy this file to .env
# only when you want to override the built-in ../ar-coordination default.
# The .env file is intentionally ignored because it is local machine config.

AR_COORDINATION_ROOT=../ar-coordination
